{
  "name": "jarvis-orb",
  "private": true,
  "version": "0.1.0",
  "description": "JARVIS-style voice orb for Hermes",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prestart": "npm run build",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-jarvis.ps1",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron electron/main.cjs\"",
    "electron:start": "electron electron/main.cjs",
    "electron:build": "npm run build && electron-builder",
    "cap:sync": "npm run build && cap sync"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^9.0.1"
  },
  "dependencies": {
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "build": {
    "appId": "com.jarvis.orb",
    "productName": "JARVIS",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}

